---
import DocLayout from '../layouts/DocLayout.astro';
import RelatedNav from '../components/RelatedNav.astro';
import { docNav, docPaths } from '../lib/docNav';
import { hant } from '../lib/hant';

const nav = docNav('en');
const breadcrumb = [
  { label: nav.home.label, href: nav.home.href },
  { label: 'not found' },
];
// GitHub Pages serves a single root 404.html, so the Chinese variant is
// rendered inline and revealed client-side for /zh/ paths.
const zhBlock = `
<p>你访问的页面不存在，但数据集还在。以下入口均可用：</p>
<ul>
<li><a href="/zh/">AHR999 指标与下载</a> —— 最新读数、图表与 JSON / CSV。</li>
<li><a href="/datasets/ahr999.json"><code>/datasets/ahr999.json</code></a> 与 <a href="/datasets/ahr999.csv"><code>/datasets/ahr999.csv</code></a> —— 原始数据。</li>
<li><a href="/zh/methodology/">方法论</a>、<a href="/zh/data-format/">数据格式</a>、<a href="/zh/api/">API</a> 与 <a href="/zh/faq/">常见问题</a>。</li>
</ul>`;
const hantBlock = hant(zhBlock).replaceAll('href="/zh/', 'href="/zh-hant/');
const bodyHtml = `
<div class="notfound-zh" lang="zh-Hans" hidden>${zhBlock}</div>
<div class="notfound-hant" lang="zh-Hant" hidden>${hantBlock}</div>
<div class="notfound-en">
<p>The page you asked for isn't here — but the dataset is. Everything below still works:</p>
<ul>
<li><a href="/">AHR999 index &amp; downloads</a> — the live reading, chart, and JSON / CSV.</li>
<li><a href="/datasets/ahr999.json"><code>/datasets/ahr999.json</code></a> and <a href="/datasets/ahr999.csv"><code>/datasets/ahr999.csv</code></a> — the raw data.</li>
<li><a href="/methodology/">Methodology</a>, <a href="/data-format/">data format</a>, <a href="/api/">API</a>, and <a href="/faq/">FAQ</a>.</li>
</ul>
</div>
`;
---

<DocLayout
  lang="en"
  noindex
  title="404 · Page not found — AHR999 dataset"
  description="That page does not exist. Browse the AHR999 index, dataset downloads, API, and methodology instead."
  eyebrow="404"
  heading="This page <em>drifted</em> off-chain"
  lead="A wrong turn — the link is broken or the page has moved."
  paths={docPaths('home')}
  breadcrumb={breadcrumb}
>
  <Fragment set:html={bodyHtml} />
  <RelatedNav slot="related" lang="en" current="home" />
</DocLayout>

<script>
  const p = location.pathname;
  const variant = /^\/zh-hant(\/|$)/.test(p)
    ? 'hant'
    : /^\/zh(\/|$)/.test(p)
      ? 'zh'
      : null;
  if (variant) {
    document.documentElement.lang = variant === 'hant' ? 'zh-Hant' : 'zh-Hans';
    document.querySelector(`.notfound-${variant}`)?.removeAttribute('hidden');
    document.querySelector('.notfound-en')?.setAttribute('hidden', '');
    const title = document.querySelector('.doc-title');
    if (title) title.textContent = variant === 'hant' ? '這個頁面不存在' : '这个页面不存在';
    const lead = document.querySelector('.doc-lead');
    if (lead)
      lead.textContent =
        variant === 'hant' ? '連結可能已失效或頁面已遷移。' : '链接可能已失效或页面已迁移。';
  }
</script>
