// Regime scale: four equal-width segments (0–0.45, 0.45–1.20, 1.20–3.00,
// 3.00–6.00); the marker is placed piecewise-linearly inside its segment.
const regimeBounds = [0, 0.45, 1.2, 3, 6];
function scalePosition(v: number | null | undefined): number | null {
  if (v === null || v === undefined || !Number.isFinite(v)) return null;
  const x = Math.min(Math.max(v, 0), regimeBounds[regimeBounds.length - 1]!);
  for (let i = 0; i < regimeBounds.length - 1; i++) {
    const lo = regimeBounds[i]!;
    const hi = regimeBounds[i + 1]!;
    if (x <= hi) return Math.round((i + (x - lo) / (hi - lo)) * 25 * 10) / 10;
  }
  return 100;
}
const markerPos = scalePosition(latest?.ahr999 ?? null);
const regimeSegments = [
  { cls: 'tier-bargain', label: t.regimeLabels.bargain, range: '< 0.45' },
  { cls: 'tier-dca', label: t.regimeLabels.dca, range: '0.45 – 1.20' },
