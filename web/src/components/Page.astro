function tierFor(value: number | null | undefined): Tier {
  if (value === null || value === undefined)
    return { ...t.tiers.na, key: 'na', cls: 'tier-na' };
  if (value < 0.45)
    return { ...t.tiers.bargain, key: 'bargain', cls: 'tier-bargain' };
  if (value < 1.2) return { ...t.tiers.dca, key: 'dca', cls: 'tier-dca' };
  if (value < 3)
    return { ...t.tiers.caution, key: 'caution', cls: 'tier-caution' };
  return { ...t.tiers.bubble, key: 'bubble', cls: 'tier-bubble' };
}

function fmtUsd(v: number | null | undefined): string {
  if (v === null || v === undefined) return '—';
  return `$${v.toLocaleString('en-US', {
    minimumFractionDigits: 2,
    maximumFractionDigits: 2,
  })}`;
}

function fmtAhr(v: number | null | undefined): string {
  if (v === null || v === undefined) return '—';
  return v.toFixed(4);
}

function fmtPct(v: number | null | undefined): string {
  if (v === null || v === undefined) return '—';
  return `${(v * 100).toFixed(1)}%`;
}

function fmtDelta(v: number | null | undefined): string {
  if (v === null || v === undefined) return '—';
  const sign = v >= 0 ? '+' : '';
  return `${sign}${v.toFixed(4)}`;
}

const tier = tierFor(latest?.ahr999 ?? null);

// Historical context — unique, data-driven copy that changes with the series.
const scored = dataset.filter(
  (r): r is Row & { ahr999: number } => typeof r.ahr999 === 'number',
);
const allTimeMin = scored.reduce((a, b) => (b.ahr999 < a.ahr999 ? b : a));
const allTimeMax = scored.reduce((a, b) => (b.ahr999 > a.ahr999 ? b : a));
const fiveYears = scored.slice(-365 * 5);
const zoneCounts = { bargain: 0, dca: 0, caution: 0, bubble: 0 };
for (const r of fiveYears) {
  const k = tierFor(r.ahr999).key;
  if (k !== 'na') zoneCounts[k] += 1;
}
const pct = (n: number): number =>
  fiveYears.length ? Math.round((n / fiveYears.length) * 100) : 0;
let streak = 0;
for (let i = scored.length - 1; i >= 0; i--) {
  if (tierFor(scored[i]!.ahr999).key !== tier.key) break;
  streak += 1;
}
const streakStart = scored[scored.length - streak]?.date ?? latestDate;
const lastBargainBeforeStreak = [...scored]
  .slice(0, scored.length - streak)
  .reverse()
  .find((r) => r.ahr999 < 0.45);
const contextStats: ContextStats = {
  value: fmtAhr(latest?.ahr999 ?? null),
  zone: tier.label,
  streak,
  share: {
    bargain: pct(zoneCounts.bargain),
    dca: pct(zoneCounts.dca),
    caution: pct(zoneCounts.caution),
    bubble: pct(zoneCounts.bubble),
  },
  min: fmtAhr(allTimeMin.ahr999),
  minDate: allTimeMin.date,
  max: fmtAhr(allTimeMax.ahr999),
  maxDate: allTimeMax.date,
  inBargain: tier.key === 'bargain',
  lastBargainDate:
    tier.key === 'bargain'
      ? streakStart
      : (lastBargainBeforeStreak?.date ?? '—'),
};
