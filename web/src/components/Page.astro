  inLanguage: ['en', 'zh-Hans'],
  description:
    'Open, daily-updated AHR999 Bitcoin hoarding index dataset for dollar-cost-averaging research, published as JSON, CSV and a read-only API.',
  license: 'https://creativecommons.org/licenses/by/4.0/',
  publisher,
});

const webPageStructuredData = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  '@id': pageUrl,
  url: pageUrl,
  name: t.title,
  description: metaDescription,
  inLanguage: isEn ? 'en' : 'zh-Hans',
  dateModified: latestDate,
  isPartOf: { '@id': websiteId },
  about: { '@id': datasetId },
  mainEntity: { '@id': datasetId },
  primaryImageOfPage: ogImageUrl,
});
---

<!doctype html>
<html lang={isEn ? 'en' : 'zh-Hans'}>
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    />
    <title>{socialTitle}</title>
    <meta name="description" content={metaDescription} />
    <meta name="theme-color" content="#0b0a08" />
    <meta name="color-scheme" content="dark" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <link rel="canonical" href={pageUrl} />
    <meta property="og:title" content={socialTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:site_name" content="ahr999 dataset" />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={socialTitle} />
    <meta name="twitter:description" content={metaDescription} />
    <meta name="twitter:image" content={ogImageUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="sitemap" type="application/xml" href={sitemapUrl} />
    <link
      rel="service-desc"
      type="application/vnd.oai.openapi+json"
      href={openApiUrl}
    />
    <link rel="api-catalog" href={apiCatalogUrl} />
    <link
      rel="alternate"
      type="application/json"
      title="AHR999 JSON dataset"
      href={datasetJsonAbsoluteUrl}
    />
    <link
      rel="alternate"
      type="text/csv"
      title="AHR999 CSV dataset"
      href={datasetCsvAbsoluteUrl}
    />
    <link
      rel="alternate"
      type="text/plain"
      title="LLMs guidance"
      href={llmsTxtUrl}
    />
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="zh-Hans" href={zhUrl} />
    <link rel="alternate" hreflang="x-default" href={enUrl} />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href="/fonts/instrument-serif-400-italic-latin.woff2"
      crossorigin="anonymous"
    />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href="/fonts/instrument-sans-400-600-normal-latin.woff2"
      crossorigin="anonymous"
    />
    <link
      rel="preload"
      as="fetch"
      href={datasetJsonUrl}
      crossorigin="anonymous"
    />
    <script type="application/ld+json" set:html={datasetStructuredData}></script>
    <script type="application/ld+json" set:html={websiteStructuredData}></script>
    <script type="application/ld+json" set:html={webPageStructuredData}></script>
  </head>
  <body>
    <div class="page-bg" aria-hidden="true">
      <div class="bg-grid"></div>
      <div class="bg-glow"></div>
      <div class="bg-glow-alt"></div>
    </div>

    <!-- HEADER -->
    <a class="skip-link" href="#main">{isEn ? 'Skip to content' : '跳到正文'}</a>
    <header class="site-header">
      <a class="brand" href="/" aria-label="ahr999 dataset — home">
        <span class="brand-mark">◐</span>
        <span class="brand-name">ahr999</span>
        <span class="brand-slash">/</span>
        <span class="brand-sub">dataset</span>
      </a>
      <div class="live-indicator" title={t.liveTitle}>
        <span class="pulse"></span>
        <span>{t.liveLabel(latestDate)}</span>
      </div>
      <nav class="site-nav" aria-label="primary">
        <a href={nav.methodology.href} class="nav-link nav-hide-md">
          {nav.methodology.navLabel}
        </a>
        <a href={nav.api.href} class="nav-link nav-hide-md">
          {nav.api.navLabel}
        </a>
        <a href={nav.faq.href} class="nav-link nav-hide-md">
          {nav.faq.navLabel}
        </a>
        <a
          href={altLangHref}
          class="lang-toggle"
          aria-label={t.langAria}
          hreflang={isEn ? 'zh-Hans' : 'en'}>{altLangLabel}</a
        >
        <a
          href="https://github.com/RuochenLyu/ahr999-dataset"
          class="nav-pill"
          target="_blank"
          rel="noopener"
        >
          <svg viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
            <path
              d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.69-.01-1.36-2.22.48-2.69-1.07-2.69-1.07-.36-.92-.89-1.17-.89-1.17-.73-.5.06-.49.06-.49.81.06 1.23.83 1.23.83.72 1.23 1.87.87 2.33.67.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.13 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.11.16 1.93.08 2.13.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.19 0 .21.15.46.55.38A8.01 8.01 0 0016 8c0-4.42-3.58-8-8-8z"
            ></path>
          </svg>
          GitHub
        </a>
      </nav>
    </header>

    <main id="main">
      <!-- HERO -->
      <section class="hero">
        <div class="hero-top">
          <div class="eyebrow reveal reveal-1">
            <span class="label-dot"></span>
            <span>{t.heroEyebrow}</span>
            <span
              class="mono"
              style="color: var(--fg-dim); margin-left: 4px;"
            >
              {t.heroUtc(latestDate)}
            </span>
          </div>

          <div class="display-value reveal reveal-2">
            <span class="num">{fmtAhr(latest?.ahr999 ?? null)}</span>
            <span class="num-sub">
              <span class="divider" aria-hidden="true"></span>
              <span class={`tier ${tier.cls}`}>
                <span class="tier-glyph" aria-hidden="true"></span>
                {tier.label}
              </span>
              <span class="mono" style="color: var(--fg-dim);">
                {tier.hint}
              </span>
            </span>
          </div>

          <h1 class="hero-title reveal reveal-3" set:html={t.heroH1Html}></h1>

          <p class="hero-lead reveal reveal-3" set:html={t.heroLeadHtml}></p>
        </div>

        <div class="metric-ribbon">
          <div class="metric-card reveal reveal-4">
            <div class="metric-label">
              <span>{t.mBtcClose}</span>
              <span class="tag">{t.mBtcCloseTag}</span>
            </div>
            <div class="metric-value">{fmtUsd(latest?.close ?? null)}</div>
          </div>
          <div class="metric-card reveal reveal-5">
            <div class="metric-label">
              <span>{t.mMa}</span>
              <span class="tag">{t.mMaTag}</span>
            </div>
            <div class="metric-value">{fmtUsd(latest?.ma200 ?? null)}</div>
          </div>
          <div class="metric-card reveal reveal-6">
            <div class="metric-label">
              <span>{t.mQ}</span>
              <span class="tag">{latest?.windowKind ?? '—'}</span>
            </div>
            <div class="metric-value">
              {fmtPct(latest?.quantile5y ?? null)}
            </div>
          </div>
          <div class="metric-card reveal reveal-7">
            <div class="metric-label">
              <span>{t.mDelta}</span>
              <span class="tag">{t.mDeltaTag}</span>
            </div>
            <div class={`metric-value ${deltaCls}`}>{fmtDelta(deltaAhr)}</div>
          </div>
        </div>

        <div class="hero-cta-row reveal reveal-8">
          <a href={datasetCsvUrl} class="btn-primary" download>
            <span>{t.ctaCsvLabel}</span>
            <span class="mono">{csvSizeKb} kB</span>
          </a>
          <a href={datasetJsonUrl} class="btn-ghost" download>
            <span>{t.ctaJsonLabel}</span>
            <span class="mono">{jsonSizeKb} kB</span>
          </a>
          <span class="mini-note">
            {t.ctaNote(rowCount.toLocaleString())}
          </span>
        </div>

        <div class="chart-wrap reveal reveal-9">
          <div class="chart-frame">
            <div class="frame-corner tl" aria-hidden="true"></div>
            <div class="frame-corner tr" aria-hidden="true"></div>
            <div class="frame-corner bl" aria-hidden="true"></div>
            <div class="frame-corner br" aria-hidden="true"></div>
            <div class="chart-overlay">
              <span
                class="chip"
                set:html={`<strong>BTCUSDT</strong> · 1d · <strong>${isEn ? 'log' : '对数'}</strong>`}
              ></span>
              <span
                class="chip"
                set:html={`<strong>ahr999</strong> · ${isEn ? 'right axis' : '右轴'}`}
              ></span>
            </div>
            <div
              id="chart"
              data-dataset-url={datasetJsonUrl}
              data-lang={lang}
              role="img"
              aria-label={t.chartAriaLabel}
            ></div>
          </div>

          <div class="chart-legend">
            <span class="swatch price">
              <span class="bar" aria-hidden="true"></span>
              <span>{t.legendBtc}</span>
            </span>
            <span class="swatch ma200">
              <span class="bar" aria-hidden="true"></span>
              <span>{t.legendMa}</span>
            </span>
            <span class="swatch ahr">
              <span class="bar" aria-hidden="true"></span>
              <span>{t.legendAhr}</span>
            </span>
            <span class="swatch floor dashed">
              <span class="bar" aria-hidden="true"></span>
              <span>{t.legendFloor}</span>
            </span>
            <span class="swatch caution dashed">
              <span class="bar" aria-hidden="true"></span>
              <span>{t.legendDca}</span>
            </span>
            <span class="chart-ranges" role="group" aria-label={t.rangeAria}>
              <button type="button" data-days="365">{t.ranges.y1}</button>
              <button type="button" data-days="730" class="active" aria-pressed="true">{t.ranges.y2}</button>
              <button type="button" data-days="1826">{t.ranges.y5}</button>
              <button type="button" data-days="0">{t.ranges.all}</button>
            </span>
          </div>
        </div>
      </section>

      <!-- HISTORICAL CONTEXT -->
      <section id="context" class="section">
        <header class="section-head">
          <div>
            <div class="eyebrow">
              <span class="label-dot"></span>
              <span>{t.contextEyebrow}</span>
            </div>
            <h2 class="section-title">{t.contextTitle}</h2>
          </div>
        </header>
        <p class="context-prose" set:html={t.contextProse(contextStats)}></p>
        <div class="metric-ribbon context-stats">
          <div class="metric-card">
            <div class="metric-label">
              <span>{t.sLow}</span>
              <span class="tag">{contextStats.minDate}</span>
            </div>
            <div class="metric-value">{contextStats.min}</div>
          </div>
          <div class="metric-card">
            <div class="metric-label">
              <span>{t.sHigh}</span>
              <span class="tag">{contextStats.maxDate}</span>
            </div>
            <div class="metric-value">{contextStats.max}</div>
          </div>
          <div class="metric-card">
            <div class="metric-label">
              <span>{t.sStreak}</span>
              <span class="tag">{t.sStreakTag(contextStats.zone)}</span>
            </div>
            <div class="metric-value">
              {t.sDays(contextStats.streak.toLocaleString())}
            </div>
          </div>
          <div class="metric-card">
            <div class="metric-label">
              <span>{t.sBargainShare}</span>
              <span class="tag">{t.sBargainShareTag}</span>
            </div>
            <div class="metric-value">{contextStats.share.bargain}%</div>
          </div>
        </div>
      </section>

      <!-- DATA TABLE (30 days) -->
      <section id="data" class="section">
        <header class="section-head">
          <div>
            <div class="eyebrow">
              <span class="label-dot"></span>
              <span>{t.dataEyebrow}</span>
            </div>
            <h2 class="section-title">{t.dataTitle}</h2>
          </div>
          <div>
            <a href={datasetJsonUrl} class="btn-ghost" download>
              <span>{t.dataCtaHistory(rowCount.toLocaleString(), String(jsonSizeKb))}</span>
              <span aria-hidden="true">→</span>
            </a>
          </div>
        </header>

        <div class="table-wrap">
          <table class="data-table" aria-label={t.dataEyebrow}>
            <thead>
              <tr>
                <th scope="col">{t.colDate}</th>
                <th scope="col" class="num">{t.colClose}</th>
                <th scope="col" class="num hide-sm">{t.colMa}</th>
                <th scope="col" class="num">{t.colAhr}</th>
                <th scope="col" class="num hide-sm">{t.colQ}</th>
                <th scope="col">{t.colRegime}</th>
              </tr>
            </thead>
            <tbody>
              {
                recent30.map((row) => {
                  const rowTier = tierFor(row.ahr999);
                  return (
                    <tr>
                      <td class="date">{row.date}</td>
                      <td class="num">{fmtUsd(row.close)}</td>
                      <td class="num hide-sm">{fmtUsd(row.ma200)}</td>
                      <td class="num strong">{fmtAhr(row.ahr999)}</td>
                      <td class="num hide-sm">{fmtPct(row.quantile5y)}</td>
                      <td>
                        <span
                          class={`regime ${rowTier.cls}`}
                          title={rowTier.label}
                        >
                          <span class="regime-dot" aria-hidden="true"></span>
                          <span class="regime-text">
                            {rowTier.key === 'na'
                              ? rowTier.label
                              : t.regimeLabels[rowTier.key]}
                          </span>
                        </span>
                      </td>
                    </tr>
                  );
                })
              }
            </tbody>
          </table>
        </div>
      </section>

      <!-- CODE ONE-LINER -->
      <section class="section section-slim">
        <div class="section-head" style="margin-bottom: 1.5rem;">
          <div>
            <div class="eyebrow">
              <span class="label-dot"></span>
              <span>{t.codeEyebrow}</span>
            </div>
            <h2 class="section-title section-title-sm">{t.codeTitle}</h2>
          </div>
        </div>

        <div
          class="code-card"
          id="copy-card"
          role="button"
          tabindex="0"
          aria-label={t.copyAria}
        >
          <div class="code-label">
            <span class="lhs">{t.codeLabel}</span>
            <span
              class="copy-hint"
              data-copy={t.codeCopy}
              data-copied={t.codeCopied}
              data-fallback={t.codeCopyFallback}>{t.codeCopy}</span
            >
          </div>
          <pre
            class="code-block"
            id="copy-src"
            data-copy={copyCommand}
          ><code><span class="prompt" aria-hidden="true">$ </span>curl <span class="flag">-s</span> <span class="url">{datasetJsonAbsoluteUrl}</span> | jq <span class="str">'.[-1]'</span></code></pre>
        </div>
      </section>

      <!-- ABOUT AHR999 -->
      <section class="about-section">
        <div class="about-header">
          <div class="eyebrow">
            <span class="label-dot"></span>
            <span>{t.aboutEyebrow}</span>
          </div>
          <h2 class="about-title" set:html={t.aboutTitleHtml}></h2>
        </div>
        <div class="about-body">
          <p set:html={t.aboutBody1Html}></p>
          <p set:html={t.aboutBody2Html}></p>
        </div>

        <div class="regime-scale" aria-label={t.scaleAria(latestAhrStr, tier.label)}>
          <div class="regime-track" aria-hidden="true">
            <span class="seg tier-bargain"></span>
            <span class="seg tier-dca"></span>
            <span class="seg tier-caution"></span>
            <span class="seg tier-bubble"></span>
            {
              markerPos !== null && (
                <span class="regime-marker" style={`left: ${markerPos}%`}>
                  <span class="regime-marker-value">{latestAhrStr}</span>
                </span>
              )
            }
          </div>
          <div class="regime-ticks" aria-hidden="true">
            <span style="left: 25%">0.45</span>
            <span style="left: 50%">1.20</span>
            <span style="left: 75%">3.00</span>
          </div>
          <div class="regime-labels">
            {
              regimeSegments.map((seg) => (
                <div class={seg.cls}>
                  <span class="label-row">
                    <span class="dot" aria-hidden="true" />
                    <span class="label">{seg.label}</span>
                  </span>
                  <span class="range">{seg.range}</span>
                </div>
              ))
            }
          </div>
        </div>
      </section>
    </main>

    <!-- FOOTER -->
    <footer class="site-footer">
      <nav class="footer-nav" aria-label={isEn ? 'documentation' : '文档'}>
        <a href={nav.methodology.href}>{nav.methodology.label}</a>
        <a href={nav.dataFormat.href}>{nav.dataFormat.label}</a>
        <a href={nav.api.href}>{nav.api.label}</a>
        <a href={nav.faq.href}>{nav.faq.label}</a>
      </nav>
      <div class="footer-strip">
        <span class="footer-brand">
          <span class="brand-mark">◐</span>
          <span class="brand-name">ahr999</span>
          <span class="brand-slash">/</span>
          <span class="brand-sub">dataset</span>
        </span>
        <span class="footer-sep" aria-hidden="true">·</span>
        <span>© {currentYear}</span>
        <span class="footer-sep" aria-hidden="true">·</span>
        <span>{t.footerLicense}</span>
        <span class="footer-sep" aria-hidden="true">·</span>
        <span>{t.footerUpdated(latestDate, rowCount.toLocaleString())}</span>
        <a
          href="https://github.com/RuochenLyu/ahr999-dataset"
          target="_blank"
          rel="noopener"
          class="footer-github">GitHub ↗</a
        >
      </div>
    </footer>

    <script>
      import * as echarts from 'echarts/core';
      import { LineChart, type LineSeriesOption } from 'echarts/charts';
      import {
        GridComponent,
        type GridComponentOption,
        TooltipComponent,
        type TooltipComponentOption,
        AxisPointerComponent,
        DataZoomComponent,
        type DataZoomComponentOption,
        MarkLineComponent,
        MarkAreaComponent,
      } from 'echarts/components';
      import { CanvasRenderer } from 'echarts/renderers';

      echarts.use([
        LineChart,
        GridComponent,
        TooltipComponent,
        AxisPointerComponent,
        DataZoomComponent,
        MarkLineComponent,
        MarkAreaComponent,
        CanvasRenderer,
      ]);

      type ChartOption = echarts.ComposeOption<
        | LineSeriesOption
        | GridComponentOption
        | TooltipComponentOption
        | DataZoomComponentOption
      >;

      type Row = {
        date: string;
        close: number;
        ma200: number | null;
        ahr999: number | null;
        quantile5y: number | null;
        windowKind: string;
      };

      const COLOR_PRICE = '#f59e0b';
      const COLOR_MA200 = '#94a3b8';
      const COLOR_AHR = '#60a5fa';
      // Zone semantics: lower AHR999 = better entry, so the bargain boundary
      // is green and the caution boundary is amber (matches the tier colours
      // in global.css: bargain green, DCA blue, caution amber, bubble red).
      const COLOR_FLOOR = '#34d399';
      const COLOR_DCA = '#f59e0b';
      const COLOR_AXIS = '#2a2620';
      const COLOR_GRID = 'rgba(64, 58, 49, 0.35)';
      const COLOR_FG = '#f7f4ee';
      const COLOR_FG_MUTED = '#a8a29a';
      const COLOR_FG_DIM = '#807a70';

      const el = document.getElementById('chart') as HTMLDivElement | null;
      if (!el) {
        throw new Error('chart container not found');
      }

      const chartLang = el.dataset.lang === 'zh' ? 'zh' : 'en';
      const ct =
        chartLang === 'zh'
          ? {
              loading: '加载中…',
              price: 'BTC 价格',
              ma: '200 日均价',
              ahr: 'ahr999',
              floor: '抄底',
              dca: '谨慎',
            }
          : {
              loading: 'loading',
              price: 'BTC price',
              ma: '200d DCA cost',
              ahr: 'ahr999',
              floor: 'Bargain',
              dca: 'Caution',
            };

      const chart = echarts.init(el, null, { renderer: 'canvas' });
      chart.showLoading({
        text: ct.loading,
        color: COLOR_AHR,
        textColor: COLOR_FG_MUTED,
        maskColor: 'transparent',
        fontSize: 12,
      });

      function formatUsd(v: number | null | undefined): string {
        if (v === null || v === undefined || Number.isNaN(v)) return '—';
        return `$${v.toLocaleString('en-US', {
          minimumFractionDigits: 2,
          maximumFractionDigits: 2,
        })}`;
      }
      function formatAhr(v: number | null | undefined): string {
        if (v === null || v === undefined || Number.isNaN(v)) return '—';
        return v.toFixed(4);
      }
      function formatDate(v: string): string {
        return (v || '').replaceAll('-', '/');
      }

      type TooltipParam = {
        axisValueLabel?: unknown;
        seriesName?: unknown;
        value?: unknown;
      };

      function isTooltipParam(value: unknown): value is TooltipParam {
        return typeof value === 'object' && value !== null;
      }

      function tooltipValue(value: unknown): number | null {
        const raw = Array.isArray(value) ? value[1] : value;
        return typeof raw === 'number' && Number.isFinite(raw) ? raw : null;
      }

      const tooltipFormatter = (params: unknown): string => {
        if (!Array.isArray(params) || params.length === 0) return '';
        const first = params.find(isTooltipParam);
        const date = formatDate(String(first?.axisValueLabel ?? ''));
        const byName: Record<string, number | null> = {};
        for (const p of params) {
          if (!isTooltipParam(p) || typeof p.seriesName !== 'string') continue;
          byName[p.seriesName] = tooltipValue(p.value);
        }

        const rows: Array<{
          swatch: string;
          color: string;
          label: string;
          value: string;
        }> = [
          {
            swatch: 'ahr-swatch',
            color: COLOR_PRICE,
            label: ct.price,
            value: formatUsd(byName['BTC price']),
          },
          {
            swatch: 'ahr-swatch ahr-swatch--hollow',
            color: COLOR_MA200,
            label: ct.ma,
            value: formatUsd(byName['MA200']),
          },
          {
            swatch: 'ahr-swatch',
            color: COLOR_AHR,
            label: ct.ahr,
            value: formatAhr(byName['AHR999']),
          },
          {
            swatch: 'ahr-swatch ahr-swatch--dashed',
            color: COLOR_FLOOR,
            label: ct.floor,
            value: '0.45',
          },
          {
            swatch: 'ahr-swatch ahr-swatch--dashed',
            color: COLOR_DCA,
            label: ct.dca,
            value: '1.20',
          },
        ];

        const rowHtml = rows
          .map(
            (r) =>
              `<tr><td><span class="${r.swatch}" style="background:${r.color};color:${r.color}"></span>${r.label}</td><td>${r.value}</td></tr>`,
          )
          .join('');

        return `<div class="ahr-tooltip"><div class="ahr-tt-date">${date}</div><table>${rowHtml}</table></div>`;
      };

      // window.innerWidth is always defined; el.clientWidth can be 0 on
      // Safari first paint before the stylesheet applies.
      // Match the CSS breakpoint in global.css so layout and chart config stay
      // in sync at the exact edge.
      const DEFAULT_RANGE_DAYS = 365 * 2;
      function startPercentForDays(days: number, total: number): number {
        return days > 0 && total > days ? 100 - (days / total) * 100 : 0;
      }

      const narrowQuery = '(max-width: 560px)';
      const isNarrowNow = (): boolean =>
        window.matchMedia(narrowQuery).matches;

      function buildOption(rows: Row[], narrow: boolean): ChartOption {
        const dates = rows.map((r) => r.date);
        const closeSeries = rows.map((r) => r.close);
        const ma200Series = rows.map((r) => r.ma200);
        const ahrSeries = rows.map((r) => r.ahr999);

        const defaultStartPercent = startPercentForDays(
          DEFAULT_RANGE_DAYS,
          dates.length,
        );

        return {
          backgroundColor: 'transparent',
          textStyle: { color: COLOR_FG, fontFamily: 'inherit' },
          animation: false,
          grid: narrow
            ? { left: 8, right: 8, top: 28, bottom: 64 }
            : { left: 72, right: 56, top: 38, bottom: 70 },
          tooltip: {
            trigger: 'axis',
            axisPointer: {
              type: 'cross',
              lineStyle: {
                color: COLOR_FG_DIM,
                width: 1,
                type: 'dashed',
                opacity: 0.8,
              },
              crossStyle: { color: COLOR_FG_DIM },
              label: {
                backgroundColor: '#0f0e0b',
                borderColor: COLOR_AXIS,
                borderWidth: 1,
                color: COLOR_FG_MUTED,
                fontFamily:
                  'JetBrains Mono, ui-monospace, SF Mono, Menlo, monospace',
                fontSize: 11,
              },
            },
            backgroundColor: 'transparent',
            borderWidth: 0,
            padding: 0,
            extraCssText: 'box-shadow: none; pointer-events:none;',
            formatter: tooltipFormatter,
            confine: true,
            position: narrow
              ? (_pt: unknown, _params: unknown, _dom: unknown, _rect: unknown, size: { viewSize: [number, number]; contentSize: [number, number] }) => {
                  // pin to the top; flip left/right to avoid the finger
                  const [viewW] = size.viewSize;
                  const [contentW] = size.contentSize;
                  const point = _pt as [number, number];
                  const onLeftHalf = point[0] < viewW / 2;
                  const left = onLeftHalf ? viewW - contentW - 8 : 8;
                  return [left, 4];
                }
              : undefined,
          },
          xAxis: {
            type: 'category',
            data: dates,
            boundaryGap: false,
            axisLine: { lineStyle: { color: COLOR_AXIS } },
            axisTick: { show: false },
            axisLabel: {
              color: COLOR_FG_DIM,
              fontFamily: 'JetBrains Mono, monospace',
              fontSize: 11,
              formatter: (value: string) =>
                value.length >= 7 ? value.slice(0, 7) : value,
              hideOverlap: true,
              showMaxLabel: narrow ? false : undefined,
            },
            splitLine: { show: false },
          },
          yAxis: [
            {
              type: 'log',
              position: 'left',
              axisLine: { show: false },
              axisTick: { show: false },
              axisLabel: {
                inside: narrow,
                margin: narrow ? 4 : 8,
                verticalAlign: narrow ? 'bottom' : 'middle',
                color: COLOR_FG_DIM,
                fontFamily: 'JetBrains Mono, monospace',
                fontSize: 11,
                formatter: (value: number): string => {
                  if (value >= 1_000_000)
                    return `$${(value / 1_000_000).toFixed(0)}M`;
                  if (value >= 1000) return `$${(value / 1000).toFixed(0)}k`;
                  return `$${value}`;
                },
              },
              splitLine: {
                lineStyle: { color: COLOR_GRID, type: 'dashed' },
              },
            },
            {
              type: 'value',
              position: 'right',
              min: 0,
              axisLine: { show: false },
              axisTick: { show: false },
              axisLabel: {
                inside: narrow,
                margin: narrow ? 4 : 8,
                verticalAlign: narrow ? 'bottom' : 'middle',
                color: COLOR_FG_DIM,
                fontFamily: 'JetBrains Mono, monospace',
                fontSize: 11,
                formatter: (value: number): string => value.toFixed(1),
              },
              splitLine: { show: false },
            },
          ],
          dataZoom: [
            {
              type: 'slider',
              start: defaultStartPercent,
              end: 100,
              height: 20,
              bottom: 18,
              borderColor: 'transparent',
              backgroundColor: 'rgba(255,255,255,0.012)',
              fillerColor: 'rgba(245, 158, 11, 0.14)',
              handleStyle: {
                color: COLOR_PRICE,
                borderColor: COLOR_PRICE,
                borderWidth: 1,
              },
              moveHandleStyle: { color: COLOR_PRICE, opacity: 0.7 },
              dataBackground: {
                lineStyle: { color: COLOR_MA200, opacity: 0.4 },
                areaStyle: { color: COLOR_MA200, opacity: 0.08 },
              },
              selectedDataBackground: {
                lineStyle: { color: COLOR_PRICE, opacity: 0.8 },
                areaStyle: { color: COLOR_PRICE, opacity: 0.14 },
              },
              textStyle: {
                color: COLOR_FG_DIM,
                fontFamily: 'JetBrains Mono, monospace',
                fontSize: 11,
              },
              brushSelect: false,
            },
          ],
          series: [
            {
              name: 'MA200',
              type: 'line',
              yAxisIndex: 0,
              data: ma200Series,
              showSymbol: false,
              sampling: 'lttb',
              lineStyle: { color: COLOR_MA200, width: 1.2, opacity: 0.7 },
              itemStyle: { color: COLOR_MA200 },
              z: 1,
            },
            {
              name: 'BTC price',
              type: 'line',
              yAxisIndex: 0,
              data: closeSeries,
              showSymbol: false,
              sampling: 'lttb',
              lineStyle: { color: COLOR_PRICE, width: 1.6 },
              itemStyle: { color: COLOR_PRICE },
              z: 2,
            },
            {
              name: 'AHR999',
              type: 'line',
              yAxisIndex: 1,
              data: ahrSeries,
              showSymbol: false,
              sampling: 'lttb',
              lineStyle: { color: COLOR_AHR, width: 1.4 },
              itemStyle: { color: COLOR_AHR },
              z: 3,
              markArea: {
                silent: true,
                data: [
                  [
                    { yAxis: 0, itemStyle: { color: COLOR_FLOOR, opacity: 0.05 } },
                    { yAxis: 0.45 },
                  ],
                  [
                    { yAxis: 1.2, itemStyle: { color: COLOR_DCA, opacity: 0.05 } },
                    { yAxis: 'max' },
                  ],
                ],
              },
              markLine: {
                silent: true,
                symbol: 'none',
                label: {
                  show: !narrow,
                  position: 'insideEndTop',
                  color: COLOR_FG_DIM,
                  fontSize: 11,
                  fontFamily: 'JetBrains Mono, monospace',
                  padding: [2, 4, 0, 4],
                },
                data: [
                  {
                    yAxis: 0.45,
                    lineStyle: {
                      color: COLOR_FLOOR,
                      type: 'dashed',
                      width: 1,
                      opacity: 0.8,
                    },
                    label: {
                      formatter: `${ct.floor} · 0.45`,
                      color: COLOR_FLOOR,
                    },
                  },
                  {
                    yAxis: 1.2,
                    lineStyle: {
                      color: COLOR_DCA,
                      type: 'dashed',
                      width: 1,
                      opacity: 0.8,
                    },
                    label: {
                      formatter: `${ct.dca} · 1.20`,
                      color: COLOR_DCA,
                    },
                  },
                ],
              },
            },
          ],
        };
      }

      let cachedRows: Row[] | null = null;
      let lastNarrow = isNarrowNow();

      async function loadAndRender(): Promise<void> {
        const url = el?.dataset.datasetUrl ?? 'datasets/ahr999.json';
        const res = await fetch(url, { cache: 'no-cache' });
        if (!res.ok) {
          throw new Error(`dataset fetch failed: ${res.status}`);
        }
        const rows = (await res.json()) as Row[];
        chart.hideLoading();
        cachedRows = rows;
        chart.setOption(buildOption(rows, lastNarrow));
      }

      // Safari first-paint guard: module scripts can execute before the
      // stylesheet applies, leaving the container at 0x0 on init. The
      // ResizeObserver catches the first valid size, replaces the window
      // resize listener, and rebuilds the option when the 560px breakpoint
      // flips (portrait<->landscape, desktop window drag).
      const ro = new ResizeObserver(() => {
        chart.resize();
        const narrow = isNarrowNow();
        if (narrow !== lastNarrow && cachedRows) {
          lastNarrow = narrow;
          chart.setOption(buildOption(cachedRows, narrow), true);
        }
      });
      ro.observe(el);

      // range presets — drive the slider dataZoom and mirror its state back
      const rangeButtons = Array.from(
        document.querySelectorAll<HTMLButtonElement>('.chart-ranges button'),
      );
      function markActiveRange(days: number | null): void {
        for (const btn of rangeButtons) {
          const active = days !== null && Number(btn.dataset.days) === days;
          btn.classList.toggle('active', active);
          btn.setAttribute('aria-pressed', active ? 'true' : 'false');
        }
      }
      for (const btn of rangeButtons) {
        btn.addEventListener('click', () => {
          if (!cachedRows) return;
          const days = Number(btn.dataset.days);
          chart.dispatchAction({
            type: 'dataZoom',
            start: startPercentForDays(days, cachedRows.length),
            end: 100,
          });
          markActiveRange(days);
        });
      }
      chart.on('datazoom', () => {
        if (!cachedRows) return;
        const option = chart.getOption() as {
          dataZoom?: Array<{ start?: number; end?: number }>;
        };
        const dz = option.dataZoom?.[0];
        if (!dz || typeof dz.start !== 'number' || typeof dz.end !== 'number') {
          return;
        }
        const total = cachedRows.length;
        const match = rangeButtons.find((btn) => {
          const days = Number(btn.dataset.days);
          const start = startPercentForDays(days, total);
          return (
            Math.abs((dz.start ?? 0) - start) < 0.05 &&
            Math.abs((dz.end ?? 100) - 100) < 0.05
          );
        });
        markActiveRange(match ? Number(match.dataset.days) : null);
      });

      loadAndRender().catch((error: unknown) => {
        chart.hideLoading();
        console.error(error);
        const msg = error instanceof Error ? error.message : String(error);
        if (el) {
          el.innerHTML = `<div style="padding:2rem;color:#f87171;font-family:JetBrains Mono,monospace;font-size:12px">failed to load dataset: ${msg}</div>`;
        }
      });

      // click-to-copy on code block — uses data-copy attr, never copies the $ prompt
      const copyCard = document.getElementById('copy-card');
      const copySrc = document.getElementById('copy-src');
      if (copyCard && copySrc) {
        const hint = copyCard.querySelector('.copy-hint') as HTMLElement | null;
        const hintOriginal = hint?.dataset.copy ?? 'click to copy';
        let hintTimer: ReturnType<typeof setTimeout> | undefined;
        const flashHint = (text: string, ms: number): void => {
          if (!hint) return;
          hint.textContent = text;
          clearTimeout(hintTimer);
          hintTimer = setTimeout(() => {
            copyCard.classList.remove('copied');
            hint.textContent = hintOriginal;
          }, ms);
        };
        const selectCommand = (): void => {
          const code = copySrc.querySelector('code');
          const selection = window.getSelection();
          if (!code || !selection) return;
          const range = document.createRange();
          range.selectNodeContents(code);
          selection.removeAllRanges();
          selection.addRange(range);
        };
        const doCopy = async (): Promise<void> => {
          const text = (copySrc as HTMLElement).dataset.copy ?? '';
          try {
            await navigator.clipboard.writeText(text);
            copyCard.classList.add('copied');
            flashHint(hint?.dataset.copied ?? 'copied', 1600);
          } catch {
            // clipboard blocked (permissions / insecure context): select the
            // command so a manual copy is one keystroke away
            selectCommand();
            flashHint(hint?.dataset.fallback ?? hintOriginal, 2400);
          }
        };
        copyCard.addEventListener('click', () => void doCopy());
        copyCard.addEventListener('keydown', (event: KeyboardEvent) => {
          if (event.key === 'Enter' || event.key === ' ') {
            event.preventDefault();
            void doCopy();
          }
        });
      }
    </script>
  </body>
</html>
