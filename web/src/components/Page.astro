}

const { lang } = Astro.props;
const isEn = lang === 'en';
const nav = docNav(lang);

type Row = {
  date: string;
  close: number;
  ma200: number | null;
  ahr999: number | null;
  quantile5y: number | null;
  windowKind: 'rolling_5y' | 'expanding' | 'insufficient_samples';
};

const dataset = datasetJson as Row[];
const latest = dataset[dataset.length - 1];
const rowCount = dataset.length;
const firstDate = dataset[0]?.date ?? '—';
const latestDate = latest?.date ?? '—';
const recent30 = [...dataset].slice(-30).reverse();

type TierKey = 'na' | 'bargain' | 'dca' | 'caution' | 'bubble';
type ContextStats = {
  value: string;
  zone: string;
  streak: number;
  share: Record<'bargain' | 'dca' | 'caution' | 'bubble', number>;
  min: string;
  minDate: string;
  max: string;
  maxDate: string;
  inBargain: boolean;
  lastBargainDate: string;
};
type Tier = { key: TierKey; label: string; cls: string; hint: string };

const t = isEn
